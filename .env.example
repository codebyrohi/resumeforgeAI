# ---- Backend (FastAPI) ----
# Used when running the backend outside Docker (compose overrides it for the container)
DATABASE_URL=mysql+pymysql://resume:resume@localhost:3307/resume_builder
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Groq (free tier) - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_PRIMARY_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# Storage: "s3" for AWS S3, "local" to write files to backend/local_storage (dev only)
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Optional CloudFront (or other CDN) base URL in front of the bucket
S3_PUBLIC_BASE_URL=

# Public base URL of this API (used to build local file URLs and public /r/{slug} links)
PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# ---- Frontend (Vite) ----
VITE_API_BASE_URL=http://localhost:8000
